# =================================================================
# Agnes Studio — 环境变量样例（复制为 .env 后填真实值）
# .env 已在 .gitignore 中，不会被提交。
#
# 键名与旧版完全一致，因此已有的 .env 可以直接拿来用。
# 注意：同一个键只写一次。同名键以「第一处」为准，写两遍后面那组会静默失效。
# =================================================================

# ---------- Agnes 图像 / 视频接口（必填） ----------
AGNES_API_KEY=sk-your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 国内版把上面一行换成：https://api.agnes-ai.cn/v1
# （视频查询端点会由该地址自动推导为同站点的 /agnesapi，无需手填）

# 默认模型（留空则用程序内置默认值）
AGNES_CHAT_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# 自建网关等特殊场景才需要：显式覆盖视频查询端点
# AGNES_VIDEO_QUERY_URL=https://your-gateway.example.com/agnesapi

# ---------- 图床（视频参考图用，二选一） ----------
# 方案 A（推荐，免费）：GitHub 公开仓库 + PAT（勾 public_repo）
GITHUB_TOKEN=
GITHUB_REPO=
# GITHUB_BRANCH=main

# 方案 B（付费 $5.99/月起）：S.EE
SEE_API_TOKEN=

# ---------- 联网搜索（可选；不填就只用本地参考） ----------
# provider 取 tavily（默认）/ bocha / serper / custom / off。
# 写成 off = 完全不联网；没配 key 时助手不会假装搜过，草稿上会写明「已跳过」。
# 详细说明见 docs/方案-上下文与知识库.md 第六节。
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# provider=custom 时必填（自建的 OpenAI 兼容搜索端点）
# SEARCH_BASE_URL=https://your-search.example/v1

# ---------- LLM（可选，OpenAI 兼容协议） ----------
# 填了这一组，任何兼容 /chat/completions 的服务都能直接用，换模型只改这里。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 供应商预设（不填上面的通用键时，自动识别下面任意一组；旧版 .env 可直接沿用）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_CHAT_MODEL=
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_CHAT_MODEL=
#
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_CHAT_MODEL=glm-4-flash
