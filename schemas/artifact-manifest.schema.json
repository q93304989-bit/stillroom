{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillroom.dev/schemas/artifact-manifest.schema.json",
  "title": "Stillroom Artifact Manifest",
  "description": "产物清单条目（v1.0 冻结）。Artifact Store 与 SQLite 分离：SQLite 只存指向本清单的轻量引用，本清单也独立落盘，便于 Replay 与跨机搬运。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "execution_id",
    "step", "kind", "uri", "sha256", "bytes", "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "artifact_id":    { "type": "string", "minLength": 1, "maxLength": 128 },
    "execution_id":   { "type": "string", "minLength": 1, "maxLength": 128 },
    "workflow_id":    { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "workflow_version": { "type": "integer", "minimum": 1 },

    "step": { "$ref": "#/$defs/step" },
    "kind": { "enum": ["image", "video", "text", "json", "file"] },
    "mime": { "type": "string", "maxLength": 128 },

    "uri":    { "type": "string", "minLength": 1, "maxLength": 1024 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes":  { "type": "integer", "minimum": 0 },

    "created_at":  { "type": "string", "format": "date-time" },
    "activated_at": { "type": "string", "format": "date-time" },

    "meta": { "type": "object", "maxProperties": 32 }
  },
  "$defs": {
    "step": {
      "enum": ["understand", "reference", "generate", "evaluate", "refine", "deliver"]
    }
  }
}
